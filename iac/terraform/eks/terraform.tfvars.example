aws_region = "us-east-1"
aws_profile = "replace-with-aws-profile"

cluster_name       = "replace-with-eks-cluster-name"
app_repository_name = "temporal-java-sumo-observability"
kubernetes_version = "1.33"
cloudwatch_log_group_retention_in_days = 7

vpc_id = "vpc-replace"
subnet_ids = [
  "subnet-replace-a",
  "subnet-replace-b"
]

endpoint_public_access = true
endpoint_public_access_cidrs = [
  "replace-with-your-public-ip/32"
]

node_instance_types = ["m6i.large"]
node_min_size       = 1
node_desired_size   = 2
node_max_size       = 3

tags = {
  Project     = "temporal-java-sumo-observability"
  ManagedBy   = "terraform"
  Environment = "evaluation"
}
