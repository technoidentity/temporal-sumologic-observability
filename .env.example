# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.

# --- App identity ---
SERVICE_NAME=temporal-java-sumo-observability
DEPLOYMENT_ENVIRONMENT=docker-local
APP_LOG_LEVEL=DEBUG

# --- Sumo Logic ---
# Access credentials used by the Helm/API validation paths.
SUMO_ACCESS_ID=
SUMO_ACCESS_KEY=
# Local Docker exporter endpoint for an existing Sumo OTLP HTTP source.
SUMOLOGIC_OTLP_SOURCE_ENDPOINT=

# --- Temporal Cloud worker (required when validating against Temporal Cloud) ---
# Namespace-scoped API key from Temporal Cloud (Worker / Admin role for your namespace)
TEMPORAL_TARGET=your-namespace.account-id.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace.account-id
TEMPORAL_TASK_QUEUE=HELLO_TASK_QUEUE
TEMPORAL_API_KEY=

# --- Temporal Cloud server metrics (required for the temporal_cloud_v1_* dashboard) ---
# Separate service account API key with the "Metrics Read-Only" role (NOT the worker key)
TEMPORAL_CLOUD_METRICS_API_KEY=
