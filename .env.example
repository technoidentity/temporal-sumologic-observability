# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.

# --- App identity ---
SERVICE_NAME=temporal-java-sumo-observability
DEPLOYMENT_ENVIRONMENT=docker-local
APP_LOG_LEVEL=DEBUG

# --- Sumo Logic (required for the OTel collector) ---
# Installation token from Sumo Logic: Manage Data -> Collection -> OpenTelemetry Collector
SUMOLOGIC_INSTALLATION_TOKEN=

# --- Temporal Cloud worker (optional — omit to use the local dev server) ---
# Namespace-scoped API key from Temporal Cloud (Worker / Admin role for your namespace)
TEMPORAL_TARGET=your-namespace.account-id.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace.account-id
TEMPORAL_TASK_QUEUE=HELLO_TASK_QUEUE
TEMPORAL_API_KEY=

# --- Temporal Cloud server metrics (optional — for temporal_cloud_v1_* dashboard only) ---
# Separate service account API key with the "Metrics Read-Only" role (NOT the worker key)
TEMPORAL_CLOUD_METRICS_API_KEY=
