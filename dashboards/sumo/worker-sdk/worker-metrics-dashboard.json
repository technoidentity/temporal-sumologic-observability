    {
      "key": "panel7be07519522745a9",
      "title": "Workflows Completed",
      "description": "Total workflows completed by this worker",
      "visualSettings": "{\"general\": {\"mode\": \"singleValueMetrics\", \"type\": \"svp\"}, \"svp\": {\"option\": \"latest\", \"label\": \"\"}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "queryKey": "A",
          "queryType": "Metrics",
          "queryString": "metric=temporal_workflow_completed_total temporal_namespace={{temporal_namespace}} task_queue={{task_queue}} workflow_type={{workflow_type}} service={{service}} | sum",
          "metricsQueryMode": "Advanced",
          "metricsQueryData": null,
          "tracesQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message"
