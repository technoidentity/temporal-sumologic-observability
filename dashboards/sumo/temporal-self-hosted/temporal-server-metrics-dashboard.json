    {
      "id": null,
      "key": "panel-1",
      "title": "Service Requests by Role",
      "description": "Frontend/History/Matching/Worker request volume (service_requests).",
      "visualSettings": "{\"general\": {\"mode\": \"timeSeries\", \"type\": \"line\"}, \"series\": {}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "queryKey": "A",
          "queryType": "Metrics",
          "queryString": "metric=service_requests service_name={{service_name}} | sum by service_name",
          "metricsQueryMode": "Advanced",
          "metricsQueryData": null,
          "tracesQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message"
